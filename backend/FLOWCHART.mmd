flowchart TD
  Start([User membuka aplikasi]) --> Login{Sudah login?}
  Login -- Tidak --> LoginForm[Input email dan password]
  LoginForm --> LoginApi[POST /auth/login]
  LoginApi --> AuthValid{Credential valid dan user aktif?}
  AuthValid -- Tidak --> LoginError[Return 401/422]
  LoginError --> LoginForm
  AuthValid -- Ya --> Token[Return token dan data user]
  Token --> Dashboard
  Login -- Ya --> Dashboard[Dashboard]

  Dashboard --> Summary[GET /dashboard/summary]
  Dashboard --> Priority[GET /dashboard/priority-products]
  Dashboard --> Activity[GET /dashboard/recent-activities]
  Summary --> DashboardView[Tampilkan dashboard stok]
  Priority --> DashboardView
  Activity --> DashboardView

  DashboardView --> Menu{Pilih menu}

  Menu -- Kategori --> CategoryList[GET /categories]
  CategoryList --> CategoryAction{Aksi kategori}
  CategoryAction -- Tambah/Edit --> SaveCategory[POST/PATCH /categories]
  CategoryAction -- Hapus --> DeleteCategory[DELETE /categories/:id]
  DeleteCategory --> CategoryUsed{Dipakai produk?}
  CategoryUsed -- Ya --> CategoryReject[Return error]
  CategoryUsed -- Tidak --> CategorySaved[Simpan perubahan]
  SaveCategory --> CategorySaved
  CategorySaved --> AuditCategory[Insert audit_logs]

  Menu -- Produk --> ProductList[GET /products]
  ProductList --> ProductAction{Aksi produk}
  ProductAction -- Tambah/Edit --> SaveProduct[POST/PATCH /products]
  SaveProduct --> ProductValidate[Validasi SKU dan barcode unik]
  ProductValidate --> ProductTransaction[Database transaction]
  ProductTransaction --> ProductSaved[Simpan products]
  ProductSaved --> InitStock{Produk baru?}
  InitStock -- Ya --> CreateStock[Buat product_stocks quantity 0]
  InitStock -- Tidak --> AuditProduct[Insert audit_logs]
  CreateStock --> AuditProduct
  ProductAction -- Nonaktif --> DisableProduct[Set is_active false]
  DisableProduct --> AuditProduct

  Menu -- Scan --> ScanInput[Scan barcode atau input SKU]
  ScanInput --> Lookup[GET /products/lookup?code=...]
  Lookup --> ProductFound{Produk ditemukan?}
  ProductFound -- Tidak --> LookupError[Return 404]
  ProductFound -- Ya --> LookupResult[Tampilkan detail produk dan stok]

  Menu -- Barang Masuk --> InboundForm[Input barang masuk]
  InboundForm --> InboundApi[POST /stock/inbound]
  InboundApi --> InboundTx[Database transaction dan lock stok]
  InboundTx --> InboundUpdate[Tambah product_stocks]
  InboundUpdate --> InboundMovement[Insert stock_movements inbound]
  InboundMovement --> InboundAudit[Insert audit_logs]
  InboundAudit --> InboundSuccess[Return success]

  Menu -- Barang Keluar --> OutboundForm[Input barang keluar]
  OutboundForm --> OutboundApi[POST /stock/outbound]
  OutboundApi --> OutboundTx[Database transaction dan lock stok]
  OutboundTx --> StockEnough{Stok cukup?}
  StockEnough -- Tidak --> StockReject[Rollback dan return stok tidak cukup]
  StockEnough -- Ya --> OutboundUpdate[Kurangi product_stocks]
  OutboundUpdate --> OutboundMovement[Insert stock_movements outbound]
  OutboundMovement --> OutboundAudit[Insert audit_logs]
  OutboundAudit --> OutboundSuccess[Return success]

  Menu -- Penjualan --> SaleForm[Input transaksi penjualan]
  SaleForm --> SaleApi[POST /sales]
  SaleApi --> SaleTx[Database transaction dan lock semua stok item]
  SaleTx --> SaleStockEnough{Semua stok cukup?}
  SaleStockEnough -- Tidak --> SaleReject[Rollback dan return stok tidak cukup]
  SaleStockEnough -- Ya --> CreateSale[Insert sales]
  CreateSale --> CreateSaleItems[Insert sale_items]
  CreateSaleItems --> SaleStockUpdate[Kurangi product_stocks]
  SaleStockUpdate --> SaleMovement[Insert stock_movements sale]
  SaleMovement --> SaleAudit[Insert audit_logs]
  SaleAudit --> SaleSuccess[Return invoice detail]

  Menu -- Laporan --> ReportType{Jenis laporan}
  ReportType -- Stok --> StockReport[GET /reports/stock]
  ReportType -- Penjualan --> SalesReport[GET /reports/sales]
  ReportType -- Masuk --> InboundReport[GET /reports/inbound]
  ReportType -- Keluar --> OutboundReport[GET /reports/outbound]
  StockReport --> ReportResult[Return paginated JSON]
  SalesReport --> ReportResult
  InboundReport --> ReportResult
  OutboundReport --> ReportResult

  AuditCategory --> End([Selesai])
  AuditProduct --> End
  LookupResult --> End
  InboundSuccess --> End
  OutboundSuccess --> End
  SaleSuccess --> End
  ReportResult --> End
